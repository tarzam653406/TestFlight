# Copy to .env and fill in. Loaded with `node --env-file`.

# Port and the single-user access token the web app / iOS app must send.
PORT=8787
APP_TOKEN=change-me-to-a-long-random-string

# Your timezone; "today", "next week", etc. are computed in it.
TIMEZONE=America/New_York

# Claude, used to turn captured thoughts into tasks.
ANTHROPIC_API_KEY=

# Google Calendar (create an OAuth client of type "Web application" in Google Cloud
# Console and add PUBLIC_URL/auth/google/callback as an authorized redirect URI).
PUBLIC_URL=http://localhost:8787
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_ID=primary
# Which local tasks get pushed to Google Calendar: none | timed | all
GOOGLE_PUSH_TASKS=timed

# Planyway / Trello. Planyway stores what you schedule on Trello cards, so sync goes
# through the Trello API. Get an API key at https://trello.com/power-ups/admin (create a
# Power-Up, then "Generate a new API key"), then open this URL to get a token:
# https://trello.com/1/authorize?expiration=never&scope=read,write&response_type=token&name=Daily%20Goals&key=YOUR_KEY
TRELLO_API_KEY=
TRELLO_TOKEN=
# Comma-separated board ids (the part after /b/ in a board URL). Empty = all your open boards.
TRELLO_BOARD_IDS=
# List id where tasks created in this app become cards (open a card in the list, add
# .json to its URL, and copy "idList"). Empty = don't create cards.
TRELLO_PUSH_LIST_ID=
# Which new tasks become cards: none | timed | all
TRELLO_PUSH_TASKS=all
# Ignore cards and checklist items assigned only to other people (set false to include them).
TRELLO_ONLY_MINE=true

# How often to run two-way sync, in minutes.
SYNC_INTERVAL_MINUTES=5
